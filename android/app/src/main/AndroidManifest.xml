<?xml version="1.0" encoding="utf-8"?>
<!-- Vanillish: one GameActivity around libvanillish.so. Every attribute here is load-bearing:
     docs/ANDROID.md says why for each. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game server, the data host, the remote console. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Haptics on the HUD and the radial menu. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Stay connected: the session service (GameSessionService) and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- wgpu's Vulkan backend: Vulkan 1.1 is the floor. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- appCategory="game": One UI files it under Game Launcher/Booster, and Android 16 keeps
         honouring the landscape lock on a large screen (the Fold's inner display) for a game.
         allowBackup="false": 5 GB of game data and the 25 MB Auto Backup quota do not mix, and the
         Keystore key that seals the saved passwords is never backed up anyway. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appCategory="game"
        android:isGame="true"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.Vanillish">

        <!-- Game Mode: the Performance / Battery modes in Game Dashboard map onto the presets. -->
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />

        <!-- configChanges: folding, unfolding, rotating, a controller or keyboard connecting, DeX,
             a theme change — none may recreate the Activity: a Bevy app cannot be built twice in
             one process. singleTask: a second launch never makes a second Activity.
             adjustNothing: the soft keyboard floats over the game rather than resizing it (the
             automatic UI scale would follow the height). -->
        <activity
            android:name=".VanillishActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale|colorMode|touchscreen|mcc|mnc|fontWeightAdjustment|grammaticalGender"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:theme="@style/Theme.Vanillish">
            <meta-data android:name="android.app.lib_name" android:value="vanillish" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [data] the FileProvider for sharing session logs goes here. -->

        <!-- The relauncher: a throwaway Activity in its own process that waits for the game's
             process to end and starts the game again in a fresh one (after a data import, or if
             Android ever brings the game's Activity back in a process that already ran it). -->
        <activity
            android:name=".Relauncher"
            android:exported="false"
            android:process=":relauncher"
            android:theme="@style/Theme.Vanillish.Invisible"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- Stay connected: while the player is in the world, a foreground service keeps the
             process (and the game's connection to its server) alive in the background, where
             Android would freeze it and the server drop the character. specialUse: no other type
             fits a game session. stopWithTask: swiping the game away ends it. -->
        <service
            android:name=".GameSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the game server connection alive while the player is briefly away from the game (another app, the lock screen), so the online session is not dropped. Runs only while the player is in the game world, and stops when they leave it or quit." />
        </service>
    </application>
</manifest>
