# Everything a Linux container reads (scripts, configs, Dockerfiles, compose) must keep LF endings,
# even in a Windows checkout with core.autocrlf=true: a CRLF shebang or config line breaks inside
# the container.
* text=auto eol=lf
*.ps1 text eol=crlf
*.png binary

# Patches to vmangos keep vmangos' own line endings byte for byte (Unit.cpp is CRLF).
docker/vmangos/patches/*.patch -text
