# The Vanillish server's settings: the only file that differs between machines.
#
# On a Mac, the setup script writes it for you: the secrets once, this Mac's address on every run,
# and the game data goes into a Docker volume, so there is nothing here to edit. Run the script again
# after moving to another network.
#
# By hand (Linux, Windows, or a Mac without the script):
#
#   cp .env.example .env      # set REALM_ADDRESS and the three secrets
#   docker compose up -d
#
# Values are unquoted; spaces are fine.

# ---- required ---------------------------------------------------------------------------------
# This machine's address on your LAN, as the phone reaches it. realmd hands it out as the world
# server's address, so `localhost` or a container name will not do. An IPv4 address (give the
# machine a fixed DHCP lease in your router) or a hostname every device resolves, 32 chars max.
# The Vanillish app reaches the world at the address you typed in it, so a stale one here does not
# stop it; other clients need this one right.
REALM_ADDRESS=192.168.1.20

# Secrets. Letters, digits, '.', '_' and '-' only. Generate each with:
#   openssl rand -hex 16
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-mangos
# The database account the data host creates players' accounts with (the app's "Create account"):
# it can add an account and nothing else, never a GM. db-init keeps it in step with this value.
SIGNUP_DB_PASSWORD=change-me-signup

# ---- the game data ----------------------------------------------------------------------------
# Your World of Warcraft 1.12.1 (build 5875, enUS) client's archives: dbc.MPQ, patch.MPQ,
# terrain.MPQ and the rest. The server's map data is extracted from them once, and the data host
# serves them to the app. Nothing from them goes into an image.
#
# Default (unset): the `vanillish-wowdata` Docker volume the Mac setup script imports them into.
# Or the client's Data folder itself, mounted read-only (absolute path; forward slashes on Windows):
#WOW_DATA_DIR=C:/Games/World of Warcraft 1.12.1/Data
#
# Optional: a German 1.12.1 client's Data folder. The app then offers German at setup: the game in
# German, quests and NPCs included, with pfQuest in German. See docs/OPERATIONS.md, "German".
#WOW_DATA_DIR_DEDE=C:/Games/WoW 1.12.1 deDE/Data
# The language of WOW_DATA_DIR's client, as the data host advertises it.
#WOW_LOCALE=enUS

# ---- the data host: what the app reads first, sign-up and the game data -------------------------
# Create account in the app: lan = only from private networks (home Wi-Fi, a VPN like Tailscale),
# open = anyone who reaches port 8099, off = accounts only through vmangos-console.
INILLA_SIGNUP=lan
# Empty: anyone on your network can download the game data and sign up, and the app needs no token
# (the easy way at home). Set one before the host is reachable from the internet; the app then asks
# for it.
INILLA_DATA_TOKEN=
# A sentence the app shows with this server, e.g. a welcome or the rules.
#INILLA_MESSAGE=

# ---- the realm --------------------------------------------------------------------------------
REALM_NAME=Vanillish
# pve, pvp, rp or rppvp
REALM_TYPE=pve
# The server's clock (day/night, resets). Any tz database name, e.g. Europe/Berlin.
TZ=UTC

# ---- server map data (extracted from the game data on the first `up`) ----------------------------
# vmaps: line of sight, indoor checks, heights (a few minutes). Strongly recommended.
EXTRACT_VMAPS=1
# mmaps: creature pathfinding around obstacles (hours on the first run). Without them mobs chase
# in straight lines. To build them while the realm keeps running, see docs/OPERATIONS.md.
EXTRACT_MMAPS=0

# ---- ports ------------------------------------------------------------------------------------
# 0.0.0.0 = reachable from the LAN (the point). 127.0.0.1 = this machine only.
BIND_ADDR=0.0.0.0
REALMD_PORT=3724
MANGOSD_PORT=8085
DATAHOST_PORT=8099

# ---- versions ---------------------------------------------------------------------------------
# The stack pulls prebuilt images for linux/amd64 and linux/arm64 from here.
#VANILLISH_REGISTRY=ghcr.io/klanthier
# The vmangos commit to run (github.com/vmangos/core, branch development). One with no prebuilt
# image is compiled on this machine on the next `up`, and db-init applies the new migrations. Pair
# it with a database snapshot no newer than the core (db-init warns when it is newer).
#VMANGOS_COMMIT=53d24d5c748bef5e0cde7b1155bcb3d979af614c
# Empty = the current db_latest release of vmangos/core, checked against the digest GitHub lists.
# A URL of your own is checked against VMANGOS_DB_SHA256 when you give one.
#VMANGOS_DB_URL=
#VMANGOS_DB_SHA256=
# Parallel compile jobs for such a local build (empty = one per core). A job takes up to 1.5 GB: 6
# suits Docker Desktop's default memory on a 16 GB Mac.
#BUILD_JOBS=
