<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Vanillish.exe's application manifest, embedded by vanillish.rc as resource 1 of RT_MANIFEST.
     No assemblyIdentity (optional for an exe, and a malformed one stops it starting) and no
     Common Controls 6 dependency (the game draws its own interface). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- The player's own rights, never an elevation prompt. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Windows 10 and 11: no compatibility shims, the real version from version queries. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Sharp at every display scale (winit asks for the same at run time); dpiAware is what
           Windows before 10 1607 reads. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <!-- Paths past MAX_PATH, where the system allows them (LongPathsEnabled). -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- UTF-8 as the process's ANSI code page: C code's narrow calls (the CRT's, Lua's) take
           and give UTF-8, as Rust's own strings are. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
